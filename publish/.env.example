# Local proxy configuration. Never commit a real token here.
PROXY_TOKEN=
# Optional overrides:
# PROXY_PORT=3000
# PROXY_TARGET=http://itamp.bocsys.cn
# PROXY_OFFLINE=1
# PROXY_RECORD=0

# API 内存缓存 TTL（毫秒）。缓存订阅条件字典 /conditions/subscribe（后端 3~4s），
# 命中响应带 X-Cache: HIT；订阅写接口会使它立即失效。设为 0 关闭。
# PROXY_API_CACHE_TTL=300000
