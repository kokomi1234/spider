/**
 * 可搜索下拉选择器（Select2 风格）
 * 
 * 功能：
 * 1. 输入框 + 下拉列表组合
 * 2. 支持输入过滤搜索
 * 3. 支持点击选项选择
 * 4. 支持键盘导航（上下键、回车、ESC）
 * 5. 自动定位到光标位置
 */

(function () {
  'use strict';

  /**
   * 创建可搜索下拉（兼容 HTMLSelectElement 和 HTMLInputElement）
   * @param {HTMLElement} targetEl - 原始 select 或 input 元素
   * @param {Array<{label: string, value: string}>} options - 选项列表
   */
  function createSearchableSelect(targetEl, options = []) {
    const isSelect = targetEl.tagName === 'SELECT';

    // 无论是 select 还是 input，都隐藏原始元素，用内部 input 替代
    targetEl.style.display = 'none';

    const container = document.createElement('div');
    container.className = 'searchable-select';
    container.style.position = 'relative';
    container.style.width = '100%';

    // 输入框
    const input = document.createElement('input');
    input.type = 'text';
    input.className = 'searchable-select-input';
    input.placeholder = targetEl.placeholder || '请输入或选择';
    input.style.width = '100%';
    input.style.padding = '8px 32px 8px 12px';
    input.style.borderRadius = 'var(--r-xs, 4px)';
    input.style.border = '1px solid var(--outline, #ddd)';
    input.style.fontSize = '14px';
    input.style.boxSizing = 'border-box';
    input.style.outline = 'none';
    input.value = isSelect ? (targetEl.value || '') : (targetEl.value || '');

    // 下拉箭头
    const arrow = document.createElement('span');
    arrow.className = 'searchable-select-arrow';
    arrow.textContent = '▼';
    arrow.style.position = 'absolute';
    arrow.style.right = '10px';
    arrow.style.top = '50%';
    arrow.style.transform = 'translateY(-50%)';
    arrow.style.pointerEvents = 'none';
    arrow.style.fontSize = '10px';
    arrow.style.color = 'var(--muted, #999)';
    arrow.style.transition = 'transform 0.2s';

    // 下拉列表容器
    const dropdown = document.createElement('div');
    dropdown.className = 'searchable-select-dropdown';
    dropdown.style.display = 'none';
    dropdown.style.position = 'absolute';
    dropdown.style.top = '100%';
    dropdown.style.left = '0';
    dropdown.style.right = '0';
    dropdown.style.maxHeight = '300px';
    dropdown.style.overflowY = 'auto';
    dropdown.style.backgroundColor = 'white';
    dropdown.style.border = '1px solid var(--outline, #ddd)';
    dropdown.style.borderRadius = 'var(--r-xs, 4px)';
    dropdown.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
    dropdown.style.zIndex = '1000';
    dropdown.style.marginTop = '2px';

    // 无结果提示
    const noResults = document.createElement('div');
    noResults.className = 'searchable-select-no-results';
    noResults.textContent = '无匹配结果';
    noResults.style.padding = '12px';
    noResults.style.textAlign = 'center';
    noResults.style.color = 'var(--muted, #999)';
    noResults.style.fontSize = '13px';
    noResults.style.display = 'none';

    // 当前选中显示
    let selectedValue = targetEl.value || '';
    let selectedIndex = -1;

    /** 渲染下拉列表 */
    function renderDropdown(filterText = '') {
      // 清空旧选项
      const oldItems = dropdown.querySelectorAll('.searchable-select-option');
      oldItems.forEach(item => item.remove());

      const filtered = filterText
        ? options.filter(opt => 
            opt.label.toLowerCase().includes(filterText.toLowerCase()) ||
            opt.value.toLowerCase().includes(filterText.toLowerCase())
          )
        : options;

      if (filtered.length === 0) {
        noResults.style.display = 'block';
      } else {
        noResults.style.display = 'none';
        filtered.forEach((opt, idx) => {
          const item = document.createElement('div');
          item.className = 'searchable-select-option';
          item.textContent = opt.label;
          item.dataset.value = opt.value;
          item.dataset.index = idx;
          item.style.padding = '8px 12px';
          item.style.cursor = 'pointer';
          item.style.fontSize = '13px';
          item.style.borderBottom = '1px solid var(--border, #f0f0f0)';
          item.style.transition = 'background 0.15s';

          // 高亮匹配文本
          if (filterText && opt.label.toLowerCase().includes(filterText.toLowerCase())) {
            const regex = new RegExp(`(${escapeRegex(filterText)})`, 'gi');
            item.innerHTML = opt.label.replace(regex, '<mark style="background:#fff3cd;padding:0;border-radius:2px;">$1</mark>');
          }

          // 选中状态
          if (opt.value === selectedValue) {
            item.style.background = 'var(--primary-light, #e3f2fd)';
            item.style.color = 'var(--primary, #1976d2)';
            item.style.fontWeight = '600';
          }

          item.addEventListener('mouseenter', () => {
            // 清除所有 hover 样式
            dropdown.querySelectorAll('.searchable-select-option').forEach(el => {
              el.style.background = '';
              el.style.color = '';
            });
            // 设置当前 hover
            item.style.background = 'var(--bg-subtle, #f5f5f5)';
          });

          item.addEventListener('mouseleave', () => {
            item.style.background = opt.value === selectedValue ? 'var(--primary-light, #e3f2fd)' : '';
            item.style.color = opt.value === selectedValue ? 'var(--primary, #1976d2)' : '';
          });

          item.addEventListener('click', () => {
            selectOption(opt);
          });

          dropdown.appendChild(item);
        });
      }
    }

    /** 选择选项 */
    function selectOption(opt) {
      selectedValue = opt.value;
      selectedIndex = options.findIndex(o => o.value === opt.value);
      input.value = opt.label;
      targetEl.value = opt.value;
      closeDropdown();
      
      // 触发 change 事件
      targetEl.dispatchEvent(new Event('change', { bubbles: true }));
    }

    /** 打开下拉 */
    function openDropdown() {
      renderDropdown(input.value);
      dropdown.style.display = 'block';
      arrow.style.transform = 'translateY(-50%) rotate(180deg)';
      input.focus();
    }

    /** 关闭下拉 */
    function closeDropdown() {
      dropdown.style.display = 'none';
      arrow.style.transform = 'translateY(-50%)';
      selectedIndex = -1;
    }

    /** 键盘导航 */
    function handleKeyDown(e) {
      const items = dropdown.querySelectorAll('.searchable-select-option');

      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          if (!dropdown.style.display || dropdown.style.display === 'none') {
            openDropdown();
            return;
          }
          selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
          highlightItem(items);
          break;

        case 'ArrowUp':
          e.preventDefault();
          if (!dropdown.style.display || dropdown.style.display === 'none') {
            openDropdown();
            return;
          }
          selectedIndex = Math.max(selectedIndex - 1, 0);
          highlightItem(items);
          break;

        case 'Enter':
          e.preventDefault();
          if (selectedIndex >= 0 && items[selectedIndex]) {
            const value = items[selectedIndex].dataset.value;
            const opt = options.find(o => o.value === value);
            if (opt) selectOption(opt);
          } else if (dropdown.style.display === 'block') {
            openDropdown();
          }
          break;

        case 'Escape':
          e.preventDefault();
          closeDropdown();
          break;

        case 'Tab':
          closeDropdown();
          break;
      }
    }

    /** 高亮当前项并滚动到可视区域 */
    function highlightItem(items) {
      items.forEach((item, idx) => {
        if (idx === selectedIndex) {
          item.style.background = 'var(--primary, #1976d2)';
          item.style.color = 'white';
          item.scrollIntoView({ block: 'nearest' });
        } else {
          const opt = options.find(o => o.value === item.dataset.value);
          item.style.background = opt?.value === selectedValue ? 'var(--primary-light, #e3f2fd)' : '';
          item.style.color = opt?.value === selectedValue ? 'var(--primary, #1976d2)' : '';
        }
      });
    }

    /** 过滤时重置索引 */
    function resetIndex() {
      selectedIndex = -1;
    }

    // 事件绑定
    input.addEventListener('focus', () => {
      if (!dropdown.style.display || dropdown.style.display === 'none') {
        renderDropdown(input.value);
      }
      dropdown.style.display = 'block';
      arrow.style.transform = 'translateY(-50%) rotate(180deg)';
    });

    input.addEventListener('input', () => {
      resetIndex();
      renderDropdown(input.value);
    });

    input.addEventListener('keydown', handleKeyDown);

    // 点击箭头切换展开/收起
    arrow.addEventListener('click', () => {
      if (dropdown.style.display === 'block') {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    // 点击外部关闭
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target)) {
        closeDropdown();
      }
    });

    // 组装 DOM
    container.appendChild(input);
    container.appendChild(arrow);
    container.appendChild(dropdown);
    container.appendChild(noResults);

    // 替换原始 select
    targetEl.parentNode.insertBefore(container, targetEl.nextSibling);

    // 暴露 API
    return {
      /** 更新选项列表 */
      updateOptions(newOptions) {
        options.length = 0;
        options.push(...newOptions);
        if (selectedValue) {
          const opt = options.find(o => o.value === selectedValue);
          if (opt) input.value = opt.label;
        }
        if (dropdown.style.display === 'block') {
          renderDropdown(input.value);
        }
      },

      /** 获取当前选中值 */
      getValue() {
        return selectedValue;
      },

      /** 设置选中值 */
      setValue(value) {
        const opt = options.find(o => o.value === value);
        if (opt) {
          selectedValue = value;
          input.value = opt.label;
          targetEl.value = value;
          if (dropdown.style.display === 'block') {
            renderDropdown(input.value);
          }
        }
      },

      /** 清空 */
      clear() {
        selectedValue = '';
        input.value = '';
        targetEl.value = '';
        if (dropdown.style.display === 'block') {
          renderDropdown('');
        }
      },

      /** 销毁 */
      destroy() {
        targetEl.style.display = '';
        container.remove();
      }
    };
  }

  /** 转义正则特殊字符 */
  function escapeRegex(string) {
    return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  if (typeof window !== 'undefined') {
    window.createSearchableSelect = createSearchableSelect;
  }
})();
