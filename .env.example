# Local proxy configuration. Never commit a real token here.
PROXY_TOKEN=
# Optional overrides:
# ⚠️ 下面这几个（PROXY_PORT / PROXY_HOST / PROXY_TARGET / PROXY_TIMEOUT）
#    **只在启动时读一次**，改了要重启 node proxy.js（token / 离线模式那类才支持热更新）。
# PROXY_PORT=3000
# 监听地址，默认 0.0.0.0（绑全网卡）—— 2026-09-20 用户拍板：内网自用、不做限制，
# 同事直接连"这份代理"就行，不用各自起。
# 只想给本机用就写 PROXY_HOST=127.0.0.1 并重启。
# 注意：不鉴权 + CORS 是 *，所以绑全网卡时同网段任何人（以及任意人浏览器里打开的任意网页）
# 都能读写 /local/saved-queries、/local/batch-times、/cache/*。想要那层锁就设下面的 token。
# PROXY_HOST=127.0.0.1
# 管理口令：设了就要求 ?token= ；不设 = 不鉴权（内网自用默认就不设）
# PROXY_ADMIN_TOKEN=
# PROXY_TARGET=http://itamp.bocsys.cn
# PROXY_OFFLINE=1
# PROXY_RECORD=0

# API 内存缓存 TTL（毫秒）。缓存订阅条件字典 /conditions/subscribe（后端 3~4s），
# 命中响应带 X-Cache: HIT；订阅写接口会使它立即失效。设为 0 关闭。
# PROXY_API_CACHE_TTL=300000

# 首页「常用查询」的团队库位置（SQLite，Node ≥ 22.5；版本更低会自动回落 JSON 文件）。
# 默认写在仓库根的 shared/saved-queries.db（只在本机生效）；
# 要跨机器共享就指向一个所有人都能访问的**同一个库文件**：
#   Windows 网络盘：PROXY_QUERIES_DB=\\\\nas\\share\\saved-queries.db
#   macOS / Linux：PROXY_QUERIES_DB=/Users/Shared/spider/saved-queries.db
# PROXY_QUERIES_DB=
# 降级到 JSON 存储时用的文件名（一般不用管）
# PROXY_QUERIES_FILE=
