# Local proxy configuration. Never commit a real token here.
PROXY_TOKEN=
# Optional overrides:
# PROXY_PORT=3000
# PROXY_TARGET=http://itamp.bocsys.cn
# PROXY_OFFLINE=1
# PROXY_RECORD=0

# API 内存缓存 TTL（毫秒）。缓存订阅条件字典 /conditions/subscribe（后端 3~4s），
# 命中响应带 X-Cache: HIT；订阅写接口会使它立即失效。设为 0 关闭。
# PROXY_API_CACHE_TTL=300000

# 首页「常用查询」的团队库文件位置。默认写在仓库根的 shared/saved-queries.json
# （只在本机生效）；要跨机器共享就指向一个所有人都能访问的同一个文件：
#   Windows 网络盘：PROXY_QUERIES_FILE=\\\\nas\\share\\saved-queries.json
#   macOS / Linux：PROXY_QUERIES_FILE=/Users/Shared/spider/saved-queries.json
# PROXY_QUERIES_FILE=
