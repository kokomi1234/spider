# macOS metadata
.DS_Store

# Local credentials and environment overrides
.env
.env.*
!.env.example

# 首页「常用查询」的共享文件：含真实查询条件 / 人名 / 部门，属运行时数据，不入库
# （代理首次写入时自动创建；要多人共享就把它指到共享盘，见 proxy.js 的 PROXY_QUERIES_FILE）
publish/config/saved-queries.json

# Real captured internal responses / sensitive network traces
publish/cache/
*.har
analysis/har/

# Local editor / runtime artifacts
.vscode/
.idea/
*.log

# Temporary verification output
output/*.png

# AI assistant workspace memory (not project code)
.workbuddy/

# AI 工具自动生成的目录（rules/toolsets 等，每次装 toolset 都会变，无版本价值）
.aixcoding/

# publish 前端：npm install 产生的目录不入库
# 注意：playwright-core 已 vendoring 在 publish/vendor/（零依赖，需随项目走），不要忽略它
publish/node_modules/

# Symlink aliases so every AI tool reads the same memory dir (.workbuddy)
.workbuddy-ai
.opencode

# 个人订阅清单（含真实 serverCoding / 组件编号，属内部数据，不入库）
publish/tools/my-subscribed-services.txt
