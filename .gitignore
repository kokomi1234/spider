# macOS metadata
.DS_Store

# Local credentials and environment overrides
.env
.env.*
!.env.example

# 首页「常用查询」的团队库：含真实查询条件 / 人名 / 部门，属运行时数据，不入库
# SQLite 主存（代理首次写入时自动创建，见 shared/README.md）；
# .json 是 Node < 22.5 时的降级产物。两者都指向共享盘即跨机器共享。
shared/saved-queries.db
shared/saved-queries.db-wal
shared/saved-queries.db-shm
shared/saved-queries.db.proxy-lock
shared/saved-queries.json
# 用户 token 库（2026-09-22 加）：**里面是明文的凭证**，绝不能入库 ——
# 与 saved-queries 同理是运行时数据，但要更严：一旦推上去就等于把别人的 token 公开了。
shared/user-tokens.db
shared/user-tokens.db-wal
shared/user-tokens.db-shm
# 定时备份产物（tools/backup-queries-db.js 写的 VACUUM INTO 快照）：同样是运行时数据，
# 而且要留在服务器上给恢复用 —— 别入库、别被 .gitignore 之外的东西搬走
shared/backups/

# 订阅页「批量修改批次时间」的落盘（2026-09-20 从 publish/config/ 搬来）：
# 同样是运行时数据，放 shared/ 是为了**重新部署时不被新包覆盖**
shared/batch-times.json

# Real captured internal responses / sensitive network traces
publish/cache/
*.har
analysis/har/

# Local editor / runtime artifacts
.vscode/
.idea/
*.log

# Temporary verification output
output/*.png
publish/output/

# AI assistant workspace memory (not project code)
.workbuddy/

# AI 工具自动生成的目录（rules/toolsets 等，每次装 toolset 都会变，无版本价值）
.aixcoding/

# publish 前端：npm install 产生的目录不入库
# 注意：playwright-core 已 vendoring 在 publish/vendor/（零依赖，需随项目走），不要忽略它
publish/node_modules/

# macOS 重复下载副本：资源管理器里同名文件会落成 "xxx 2.js"，vendoring 目录因此长期脏
# （2026-09-19 清理过 104 个，共 12.8MB；只在 vendor 内忽略，避免误伤正常文件名）
publish/vendor/**/* 2.*

# 各 AI 工具默认读的记忆目录名（都指向同一份 .workbuddy）
# 实况（2026-09-19 复核，别再记错）：`.workbuddy-ai` 是**10 字节文本文件**（内容 `.workbuddy`），
# **不是 symlink** —— 之前想改成 symlink，但那步没落地；`.opencode` 是个只含 .gitignore 的目录。
# 三者都只是"名字指过来"的占位，**不存任何记忆内容**，所以记忆只有一处：`.workbuddy/memory/`。
.workbuddy-ai
.opencode
.opencode.bak

# 个人订阅清单（含真实 serverCoding / 组件编号，属内部数据，不入库）
publish/tools/my-subscribed-services.txt
